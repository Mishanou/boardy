# ИСПОЛЬЗУЕМ АКТУАЛЬНУЮ СТАБИЛЬНУЮ ВЕРСИЮ PYTHON (Замена 3.11 на 3.12)
FROM python:3.12-slim

# Устанавливаем системные зависимости, необходимые для сборки некоторых Python-пакетов
# (например, для компиляции mysql-клиентов или криптографии, если потребуется)
RUN apt-get update && apt-get install -y \
    gcc \
    libmariadb-dev \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Отключаем генерацию файлов .pyc и включаем моментальный вывод логов в консоль
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# СНАЧАЛА копируем только файл зависимостей.
# Это критически важно для кэширования: пока requirements.txt не меняется,
# Docker не будет заново скачивать и устанавливать библиотеки при изменении кода.
COPY requirements.txt .

# Обновляем pip и устанавливаем зависимости
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# КОПИРУЕМ остальной исходный код приложения в контейнер
COPY . .

# Открываем порт 8000, на котором будет работать FastAPI
EXPOSE 8000

# Запускаем сервер uvicorn
# Приложение запускается на хосте 0.0.0.0 (чтобы отвечать на запросы Nginx из контейнерной сети)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]